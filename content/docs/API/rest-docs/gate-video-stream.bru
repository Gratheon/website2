meta {
  name: Gate Video Stream API
  type: collection
}

vars {
  baseUrl: https://video.gratheon.com
  apiToken: replace-with-your-token
}

---

meta {
  name: Generate an HLS playlist for a hive entrance video stream
  type: http
}

get {
  url: {{baseUrl}}/hls/{uid}/{boxId}/{streamId}/playlist.m3u8
}
