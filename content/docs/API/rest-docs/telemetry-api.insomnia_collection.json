{
  "_type": "export",
  "__export_format": 4,
  "__export_source": "gratheon-docs",
  "resources": [
    {
      "_id": "wrk_Telemetry_API",
      "_type": "workspace",
      "name": "Telemetry API",
      "description": "Versioned REST API used by edge devices to submit hive sensor telemetry and entrance movement metrics. GraphQL remains the preferred API for web-app integrations.",
      "scope": "collection"
    },
    {
      "_id": "env_Telemetry_API",
      "_type": "environment",
      "parentId": "wrk_Telemetry_API",
      "name": "Base Environment",
      "data": {
        "baseUrl": "https://telemetry.gratheon.com",
        "apiToken": "replace-with-your-token"
      }
    },
    {
      "_id": "req_Telemetry_API_GET__health",
      "_type": "request",
      "parentId": "wrk_Telemetry_API",
      "name": "Check service health",
      "method": "GET",
      "url": "{{ _.baseUrl }}/health",
      "body": {},
      "headers": []
    },
    {
      "_id": "req_Telemetry_API_POST__iot_v1_metrics",
      "_type": "request",
      "parentId": "wrk_Telemetry_API",
      "name": "Submit IoT sensor metrics",
      "method": "POST",
      "url": "{{ _.baseUrl }}/iot/v1/metrics",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"hiveId\": \"hive-123\",\n  \"timestamp\": 1717238400,\n  \"dedupeKey\": \"device-7:1717238400\",\n  \"fields\": {\n    \"temperatureCelsius\": 25.5,\n    \"humidityPercent\": 65,\n    \"weightKg\": 45.2\n  }\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{ _.apiToken }}"
        }
      ]
    },
    {
      "_id": "req_Telemetry_API_POST__entrance_v1_movement",
      "_type": "request",
      "parentId": "wrk_Telemetry_API",
      "name": "Submit entrance movement metrics",
      "method": "POST",
      "url": "{{ _.baseUrl }}/entrance/v1/movement",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"hiveId\": \"hive-123\",\n  \"boxId\": \"box-entrance-1\",\n  \"beesOut\": 42,\n  \"beesIn\": 39,\n  \"netFlow\": -3,\n  \"avgSpeed\": 7.4,\n  \"p95Speed\": 14.1,\n  \"stationaryBees\": 5,\n  \"detectedBees\": 81,\n  \"beeInteractions\": 12,\n  \"timestamp\": 1717238400\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{ _.apiToken }}"
        }
      ]
    }
  ]
}
